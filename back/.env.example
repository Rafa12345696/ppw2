# Copia este archivo como .env y llena los valores. NUNCA subas el .env a git.
# En Render estas mismas variables van en Environment.

# --- Bases de datos ---
# MongoDB Atlas: catalogo, usuarios, pedidos y pagos
DATABASE_URL=
# PostgreSQL (Neon): bitacora de acciones del admin. Sin ella la bitacora queda desactivada
POSTGRES_URL=

# --- Sesion y URLs ---
# Clave larga y aleatoria para firmar los JWT. En Render es obligatoria
JWT_ACCESS_SECRET=
# URL del frontend (enlaces de correos y regreso de pagos)
FRONTEND_URL=http://localhost:4321
# Origenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:4321
# URL publica https del backend (para webhooks). En local se deja vacia
BACKEND_PUBLIC_URL=

# --- Mercado Pago ---
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# --- PayPal ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox o live
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=MXN
PAYPAL_WEBHOOK_ID=

# --- Cloudinary (imagenes de productos) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Brevo (correo: recuperacion de contrasena y avisos de pedido) ---
BREVO_API_KEY=
# Correo remitente verificado en Brevo
MAIL_REMITENTE=

# --- Didit (verificacion de identidad con INE + selfie) ---
# Con DIDIT_API_KEY y DIDIT_WORKFLOW_ID puestos, comprar exige identidad verificada
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
# Secreto del webhook (Didit Console > Webhooks)
DIDIT_WEBHOOK_SECRET=

# --- Twilio (avisos de pedido por WhatsApp) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numero del sandbox de WhatsApp de Twilio
TWILIO_WHATSAPP_FROM=+14155238886
