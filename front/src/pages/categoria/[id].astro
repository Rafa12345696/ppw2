---
import TopBar from '../../components/TopBar.astro';
import CatalogoVivo from '../../components/islands/CatalogoVivo.jsx';
import { graphqlFetchSSR } from '../../api.js';
import '../../index.css';

const { id } = Astro.params;

const QUERY = `
  query($categoriaId: ID!) {
    productosPorCategoria(categoriaId: $categoriaId) {
      id
      nombre
      precio
      stock
      imagen
      categoriaId
    }
    categoriaPorId(id: $categoriaId) {
      nombre
    }
  }
`;

let productos = [];
let nombreCategoria = '';
let error = false;

try {
  const data = await graphqlFetchSSR(QUERY, { categoriaId: id });
  if (!data) error = true;
  productos = data?.productosPorCategoria || [];
  nombreCategoria = data?.categoriaPorId?.nombre || '';
} catch (e) {
  error = true;
}
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{nombreCategoria || 'Categoria'} — Elixir</title>
  </head>
  <body>
    <TopBar />
    <a href="/tienda" style="display: inline-block; margin: 1rem;">Volver</a>

    <h2 style="padding: 0 1rem;">{nombreCategoria}</h2>

    {error && (
      <div style="padding: 1rem; color: #b00020;">
        <p>Ocurrio un error al cargar los productos de esta categoria. Intentando de nuevo...</p>
      </div>
    )}

    <CatalogoVivo client:load productos={productos} categoriaId={id} recargarAlMontar={error} />
  </body>
</html>