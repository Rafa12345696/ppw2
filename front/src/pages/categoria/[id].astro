---
// Sin prerender: los productos se piden en cada visita
import Base from '../../layouts/Base.astro';
import CatalogoVivo from '../../components/islands/CatalogoVivo.jsx';
import { graphqlFetchSSR } from '../../api.js';

const { id } = Astro.params;

const QUERY = `
  query($categoriaId: ID!) {
    productosPorCategoria(categoriaId: $categoriaId) {
      id
      nombre
      precio
      precioAntes
      premium
      stock
      imagen
      categoriaId
    }
    categoriaPorId(id: $categoriaId) {
      id
      nombre
    }
    masVendidos(limite: 8) {
      id
    }
  }
`;

let productos = [];
let masVendidos = [];
let categoria = null;
let error = false;

try {
  const data = await graphqlFetchSSR(QUERY, { categoriaId: id });
  if (!data) error = true;
  productos = data?.productosPorCategoria || [];
  categoria = data?.categoriaPorId || null;
  masVendidos = (data?.masVendidos || []).map((p) => p.id);
} catch (e) {
  error = true;
}

const nombre = categoria?.nombre || 'Categoria';
---

<Base titulo={nombre}>
  <div class="contenedor pagina">
    <nav class="migas" aria-label="Ruta">
      <ol>
        <li><a href="/tienda">Inicio</a></li>
        <li aria-current="page">{nombre}</li>
      </ol>
    </nav>
    <div class="encabezado-pagina">
      <h1>{nombre}</h1>
    </div>

    {error && (
      <div class="alerta alerta-aviso" role="status" style="margin-bottom: 16px;">
        No pudimos cargar los productos desde el servidor. Lo estamos intentando de nuevo...
      </div>
    )}

    {!error && !categoria ? (
      <div class="vacio">
        <h2>Esta categoria no existe</h2>
        <p>Puede que se haya eliminado o que el enlace este mal escrito.</p>
        <a class="btn btn-neutro" href="/tienda">Ir a la tienda</a>
      </div>
    ) : (
      <CatalogoVivo
        client:load
        productos={productos}
        categoriaId={id}
        categorias={categoria ? [categoria] : []}
        recargarAlMontar={error}
        masVendidos={masVendidos}
      />
    )}
  </div>
</Base>
