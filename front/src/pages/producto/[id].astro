---
// Sin prerender: el producto se pide en cada visita
import Base from '../../layouts/Base.astro';
import ProductoVivo from '../../components/islands/ProductoVivo.jsx';
import { graphqlFetchSSR } from '../../api.js';

const { id } = Astro.params;

const QUERY = `
  query($id: ID!) {
    productoPorId(id: $id) {
      id
      nombre
      precio
      precioAntes
      premium
      stock
      descripcion
      imagen
      categoriaId
      categoria { id nombre }
    }
  }
`;

let producto = null;
let error = false;

try {
  const data = await graphqlFetchSSR(QUERY, { id });
  producto = data?.productoPorId || null;
} catch (e) {
  error = true;
}

// Datos estructurados (JSON-LD Product): Google lee nombre, foto, precio y si hay existencias
const jsonLd = producto && {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: producto.nombre,
  sku: producto.id,
  ...(producto.descripcion && { description: producto.descripcion }),
  ...(producto.imagen && { image: new URL(producto.imagen, Astro.site ?? Astro.url).href }),
  ...(producto.categoria && { category: producto.categoria.nombre }),
  offers: {
    '@type': 'Offer',
    url: new URL(Astro.url.pathname, Astro.site ?? Astro.url).href,
    price: producto.precio.toFixed(2),
    priceCurrency: 'MXN',
    availability: producto.stock > 0 ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
    itemCondition: 'https://schema.org/NewCondition',
  },
};
// "<" escapado para que un texto del producto no pueda cerrar la etiqueta <script>
const jsonLdTexto = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : '';

const descripcion = producto
  ? producto.descripcion || `Compra ${producto.nombre} en linea en Elixir con pago seguro.`
  : undefined;
---

<Base titulo={producto?.nombre || 'Producto'} descripcion={descripcion} imagen={producto?.imagen} tipo={producto ? 'product' : 'website'}>
  {jsonLd && <script is:inline slot="head" type="application/ld+json" set:html={jsonLdTexto} />}
  <div class="contenedor pagina">
    <nav class="migas" aria-label="Ruta">
      <ol>
        <li><a href="/tienda">Inicio</a></li>
        {producto?.categoria && <li><a href={`/categoria/${producto.categoria.id}`}>{producto.categoria.nombre}</a></li>}
        <li aria-current="page">{producto?.nombre || 'Producto'}</li>
      </ol>
    </nav>

    {error && (
      <div class="alerta alerta-error" role="alert">Ocurrio un error al cargar este producto. Intenta recargar la pagina.</div>
    )}

    {!error && !producto && (
      <div class="vacio">
        <h1>Producto no encontrado</h1>
        <p>Puede que ya no este a la venta.</p>
        <a class="btn btn-neutro" href="/tienda">Ver el catalogo</a>
      </div>
    )}

    {!error && producto && <ProductoVivo client:load producto={producto} />}
  </div>
</Base>
