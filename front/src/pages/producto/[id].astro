---
// Sin prerender: el producto se pide en cada visita
import Base from '../../layouts/Base.astro';
import ProductoVivo from '../../components/islands/ProductoVivo.jsx';
import { graphqlFetchSSR } from '../../api.js';

const { id } = Astro.params;

const QUERY = `
  query($id: ID!) {
    productoPorId(id: $id) {
      id
      nombre
      precio
      precioAntes
      premium
      stock
      descripcion
      imagen
      categoriaId
      categoria { id nombre }
    }
  }
`;

let producto = null;
let error = false;

try {
  const data = await graphqlFetchSSR(QUERY, { id });
  producto = data?.productoPorId || null;
} catch (e) {
  error = true;
}
---

<Base titulo={producto?.nombre || 'Producto'} descripcion={producto?.descripcion}>
  <div class="contenedor pagina">
    <nav class="migas" aria-label="Ruta">
      <ol>
        <li><a href="/tienda">Inicio</a></li>
        {producto?.categoria && <li><a href={`/categoria/${producto.categoria.id}`}>{producto.categoria.nombre}</a></li>}
        <li aria-current="page">{producto?.nombre || 'Producto'}</li>
      </ol>
    </nav>

    {error && (
      <div class="alerta alerta-error" role="alert">Ocurrio un error al cargar este producto. Intenta recargar la pagina.</div>
    )}

    {!error && !producto && (
      <div class="vacio">
        <h1>Producto no encontrado</h1>
        <p>Puede que ya no este a la venta.</p>
        <a class="btn btn-neutro" href="/tienda">Ver el catalogo</a>
      </div>
    )}

    {!error && producto && <ProductoVivo client:load producto={producto} />}
  </div>
</Base>
