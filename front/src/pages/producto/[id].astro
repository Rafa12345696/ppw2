---
import TopBar from '../../components/TopBar.astro';
import ProductoVivo from '../../components/islands/ProductoVivo.jsx';
import { graphqlFetchSSR } from '../../api.js';
import '../../index.css';

const { id } = Astro.params;

const QUERY = `
  query($id: ID!) {
    productoPorId(id: $id) {
      id
      nombre
      precio
      stock
      descripcion
      imagen
      categoriaId
    }
  }
`;

let producto = null;
let error = false;

try {
  const data = await graphqlFetchSSR(QUERY, { id });
  producto = data?.productoPorId || null;
} catch (e) {
  error = true;
}
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{producto?.nombre || 'Producto'} — Elixir</title>
  </head>
  <body>
    <TopBar />
    <a href="/tienda" style="display: inline-block; margin: 1rem;">Volver</a>

    {error && (
      <div style="padding: 1rem; color: #b00020;">
        <p>Ocurrio un error al cargar este producto.</p>
      </div>
    )}

    {!error && !producto && (
      <p style="padding: 1rem;">Producto no encontrado.</p>
    )}

    {!error && producto && <ProductoVivo client:load producto={producto} />}
  </body>
</html>