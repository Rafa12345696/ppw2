---
export const prerender = true;
import Base from '../layouts/Base.astro';
import RegistroForm from '../components/islands/RegistroForm.jsx';
---

<Base titulo="Crear cuenta">
  <div class="contenedor">
    <div class="caja-acceso tarjeta pila-lg">
      <div>
        <h1>Crear cuenta</h1>
        <p class="subtitulo">Necesitas ser mayor de 18 años para comprar en Elixir.</p>
      </div>
      <RegistroForm client:load />
      <hr class="separador" style="margin: 0;" />
      <p class="texto-2">¿Ya tienes cuenta? <a href="/login">Inicia sesion</a></p>
    </div>
  </div>
</Base>
