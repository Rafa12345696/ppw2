  <div class="contenedor">
    <div class="caja-acceso tarjeta pila-lg">
      <div>
        <h1>Nueva contraseña</h1>
        <p class="subtitulo">Elige una contraseña de al menos 6 caracteres.</p>
      </div>
      <RestablecerPasswordForm client:load />
    </div>
  </div>
</Base>
