---
// Sin prerender: el catalogo se pide en cada visita
import Base from '../layouts/Base.astro';
import CatalogoVivo from '../components/islands/CatalogoVivo.jsx';
import { graphqlFetchSSR } from '../api.js';

const QUERY = `
  query {
    categorias {
      id
      nombre
      productos {
        id
        nombre
        precio
        precioAntes
        premium
        stock
        imagen
        categoriaId
      }
    }
    masVendidos(limite: 8) {
      id
    }
  }
`;

let categorias = [];
let masVendidos = [];
let error = false;

try {
  const data = await graphqlFetchSSR(QUERY);
  if (!data?.categorias) error = true;
  categorias = data?.categorias || [];
  masVendidos = (data?.masVendidos || []).map((p) => p.id);
} catch (e) {
  error = true;
}

const todosLosProductos = categorias.flatMap((c) => c.productos);
const listaCategorias = categorias.map((c) => ({ id: c.id, nombre: c.nombre }));

// El titulo responde a lo que el cliente pidio desde la barra superior
const busqueda = (Astro.url.searchParams.get('q') || '').trim().slice(0, 80);
const destacado = Astro.url.searchParams.get('destacado');
const TITULOS = { promo: 'Promociones', premium: 'Licores premium', vendidos: 'Los mas vendidos' };
const titulo = busqueda ? `Resultados para “${busqueda}”` : TITULOS[destacado] || 'Todos los licores';
---

<Base titulo={busqueda ? `Buscar: ${busqueda}` : TITULOS[destacado] || 'Tienda'}>
  <div class="contenedor pagina">
    <nav class="migas" aria-label="Ruta">
      <ol>
        <li><a href="/tienda">Inicio</a></li>
        <li aria-current="page">{titulo}</li>
      </ol>
    </nav>
    <div class="encabezado-pagina">
      <h1>{titulo}</h1>
    </div>

    {error && (
      <div class="alerta alerta-aviso" role="status" style="margin-bottom: 16px;">
        No pudimos cargar el catalogo desde el servidor. Lo estamos intentando de nuevo...
      </div>
    )}

    <CatalogoVivo
      client:load
      productos={todosLosProductos}
      categorias={listaCategorias}
      recargarAlMontar={error}
      masVendidos={masVendidos}
      busquedaInicial={busqueda}
      destacadoInicial={destacado}
    />
  </div>
</Base>
