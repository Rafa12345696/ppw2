---
import TopBar from '../components/TopBar.astro';
import CatalogoVivo from '../components/islands/CatalogoVivo.jsx';
import { graphqlFetchSSR } from '../api.js';
import '../index.css';

const QUERY = `
  query {
    categorias {
      id
      nombre
      productos {
        id
        nombre
        precio
        stock
        imagen
        categoriaId
      }
    }
  }
`;

let categorias = [];
let error = false;

try {
  const data = await graphqlFetchSSR(QUERY);
  if (!data?.categorias) error = true;
  categorias = data?.categorias || [];
} catch (e) {
  error = true;
}

const todosLosProductos = categorias.flatMap((c) => c.productos);
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tienda — Elixir</title>
  </head>
  <body>
    <TopBar />

    <section style="padding: 2rem; background: #222; color: white;">
      <h1>Bienvenido a Elixir</h1>
      <p>Los mejores licores, directo a tu puerta.</p>
    </section>

    <div style="display: flex;">
      <aside style="padding: 1rem; min-width: 150px; border-right: 1px solid #ddd;">
        <h4>Categorias</h4>
        {categorias.map((cat) => (
          <a href={`/categoria/${cat.id}`} style="display: block; padding: 0.4rem 0; color: inherit; text-decoration: none;">
            {cat.nombre}
          </a>
        ))}
      </aside>

      <main style="flex: 1;">
        <h3 style="padding: 0 1rem;">Catalogo</h3>

        {error && (
          <div style="padding: 1rem; color: #b00020;">
            <p>Ocurrio un error al cargar los productos. Intentando de nuevo...</p>
          </div>
        )}

        <CatalogoVivo client:load productos={todosLosProductos} recargarAlMontar={error} />
      </main>
    </div>

    <section style="padding: 1rem; background: #f5f5f5;">
      <h4>Venta responsable</h4>
      <p>Este sitio es exclusivo para mayores de edad. Verificamos tu identidad antes de completar cualquier compra.</p>
    </section>

    <footer style="padding: 1rem; background: #111; color: white; text-align: center;">
      Elixir © 2026
    </footer>
  </body>
</html>