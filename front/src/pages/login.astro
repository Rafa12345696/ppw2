---
export const prerender = true;
import Base from '../layouts/Base.astro';
import LoginForm from '../components/islands/LoginForm.jsx';
---

<Base titulo="Iniciar sesion">
  <div class="contenedor">
    <div class="caja-acceso tarjeta pila-lg">
      <div>
        <h1>Iniciar sesion</h1>
        <p class="subtitulo">Entra para comprar y ver tus pedidos.</p>
      </div>
      <LoginForm client:load />
      <hr class="separador" style="margin: 0;" />
      <p class="texto-2">¿No tienes cuenta? <a href="/registro">Crea una aqui</a></p>
    </div>
  </div>
</Base>
