---
import TopBar from '../../../components/TopBar.astro';
import FormularioProducto from '../../../components/islands/FormularioProducto.jsx';
import '../../../index.css';

const { id } = Astro.params;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Editar producto — Elixir</title>
  </head>
  <body>
    <TopBar />
    <div style="padding: 2rem;">
      <a href="/admin">Volver</a>
      <h2>Editar producto</h2>
      <FormularioProducto productoId={id} client:load />
    </div>
  </body>
</html>