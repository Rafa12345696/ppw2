---
import Base from '../../../layouts/Base.astro';
import FormularioProducto from '../../../components/islands/FormularioProducto.jsx';

// Sin prerender: el id viene en la URL de cada visita
const { id } = Astro.params;
---

<Base titulo="Editar producto - Admin" admin>
  <div class="contenedor pagina">
    <nav class="migas" aria-label="Ruta">
      <ol>
        <li><a href="/admin/productos">Productos</a></li>
        <li aria-current="page">Editar</li>
      </ol>
    </nav>
    <div class="encabezado-pagina"><h1>Editar producto</h1></div>
    <FormularioProducto productoId={id} client:load />
  </div>
</Base>
