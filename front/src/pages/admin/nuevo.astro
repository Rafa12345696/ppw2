---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import FormularioProducto from '../../components/islands/FormularioProducto.jsx';
---

<Base titulo="Nuevo producto - Admin" admin>
  <div class="contenedor pagina">
    <nav class="migas" aria-label="Ruta">
      <ol>
        <li><a href="/admin/productos">Productos</a></li>
        <li aria-current="page">Nuevo</li>
      </ol>
    </nav>
    <div class="encabezado-pagina"><h1>Nuevo producto</h1></div>
    <FormularioProducto client:load />
  </div>
</Base>
