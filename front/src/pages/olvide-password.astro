---
export const prerender = true;
import Base from '../layouts/Base.astro';
import OlvidePasswordForm from '../components/islands/OlvidePasswordForm.jsx';
---

<Base titulo="Recuperar contraseña">
  <div class="contenedor">
    <div class="caja-acceso tarjeta pila-lg">
      <div>
        <h1>Recuperar contraseña</h1>
        <p class="subtitulo">Te enviaremos un enlace para crear una nueva.</p>
      </div>
      <OlvidePasswordForm client:load />
    </div>
  </div>
</Base>
