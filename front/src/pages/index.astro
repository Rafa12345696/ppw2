---
export const prerender = true;
import Base from '../layouts/Base.astro';
---

<Base titulo="Bienvenido" sinCabecera>
  <div class="contenedor" style="min-height: 100vh; display: flex; align-items: center; justify-content: center; padding-block: 48px;">
    <div class="pila-lg" style="max-width: 480px; text-align: center; align-items: center;">
      <span class="logo" style="font-size: 3rem;">elixir</span>
      <div class="pila-sm">
        <h1 style="font-size: 1.75rem;">Licores seleccionados, directo a tu puerta</h1>
        <p class="texto-2">Tequila, whisky y mas, con pago seguro y seguimiento de tu pedido en tiempo real.</p>
      </div>
      <div class="pila-sm" style="width: 100%; max-width: 320px;">
        <a href="/login" class="btn btn-primario btn-lg btn-bloque">Iniciar sesion</a>
        <a href="/tienda" class="btn btn-neutro btn-bloque">Ver la tienda como invitado</a>
      </div>
      <p class="texto-3">Venta exclusiva para mayores de 18 años. Evita el exceso.</p>
    </div>
  </div>
</Base>
