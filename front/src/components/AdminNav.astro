---
const ruta = Astro.url.pathname.replace(/\/$/, '') || '/';
const enlaces = [
  { href: '/admin', texto: 'Resumen' },
  { href: '/admin/productos', texto: 'Productos' },
  { href: '/admin/categorias', texto: 'Categorias' },
  { href: '/admin/pedidos', texto: 'Pedidos' },
  { href: '/admin/pagos', texto: 'Pagos' },
  { href: '/admin/facturas', texto: 'Comprobantes' },
  { href: '/admin/usuarios', texto: 'Usuarios' },
  { href: '/admin/bitacora', texto: 'Bitacora' },
];
// "Productos" tambien queda activo al crear o editar un producto
const activo = (href) =>
  href === '/admin'
    ? ruta === '/admin'
    : ruta.startsWith(href) || (href === '/admin/productos' && (ruta.startsWith('/admin/nuevo') || ruta.startsWith('/admin/editar')));
---

<nav class="nav-admin" aria-label="Panel de administracion">
  <ul class="contenedor">
    {enlaces.map((e) => (
      <li><a href={e.href} aria-current={activo(e.href) ? 'page' : undefined}>{e.texto}</a></li>
    ))}
  </ul>
</nav>
